@baseUrl = http://localhost:8080
@adminToken = paste-admin-token-here
@userToken = paste-user-token-here
@userId = 1
@reservationId = 1

### Register user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "naam": "Http",
  "achterNaam": "Tester",
  "email": "http-tester@example.com",
  "wachtwoord": "StrongPass1",
  "terms": true
}

### Login admin and copy the token into @adminToken
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "email": "admin@gmail.com",
  "wachtwoord": "AdminUser!1"
}

### Login seeded user and copy the token into @userToken
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "email": "pokemon@gmail.com",
  "wachtwoord": "Pokemon!23"
}

### List users as admin
GET {{baseUrl}}/users
Authorization: Bearer {{adminToken}}

### Get user by id as admin
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{adminToken}}

### Update user as admin
PUT {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "naam": "AdminUpdated",
  "achternaam": "User",
  "email": "admin-updated@example.com",
  "profileImageUrl": "https://example.com/profile.png",
  "active": true,
  "notLocked": true
}

### Delete user as admin
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{adminToken}}

### List rooms
GET {{baseUrl}}/kamers
Authorization: Bearer {{userToken}}

### Get room by name
GET {{baseUrl}}/kamers/kamer2
Authorization: Bearer {{userToken}}

### Create room as admin
POST {{baseUrl}}/kamers
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "naam": "http-room",
  "start": "2026-04-13T08:00:00.000Z",
  "sluit": "2026-04-13T18:00:00.000Z"
}

### Update room as admin
PUT {{baseUrl}}/kamers/http-room
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "naam": "http-room-updated",
  "start": "2026-04-13T09:00:00.000Z",
  "sluit": "2026-04-13T19:00:00.000Z"
}

### Delete room as admin
DELETE {{baseUrl}}/kamers/http-room-updated
Authorization: Bearer {{adminToken}}

### List reservations for current user
GET {{baseUrl}}/reserveringen
Authorization: Bearer {{userToken}}

### Create reservation
POST {{baseUrl}}/reserveringen
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "kamerNaam": "kamer2",
  "startTijd": "2026-04-13T09:00:00.000Z",
  "eindTijd": "2026-04-13T10:00:00.000Z"
}

### Get reservation by id
GET {{baseUrl}}/reserveringen/{{reservationId}}
Authorization: Bearer {{userToken}}

### Update reservation by id
PUT {{baseUrl}}/reserveringen/{{reservationId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "kamerNaam": "kamer2",
  "startTijd": "2026-04-13T10:00:00.000Z",
  "eindTijd": "2026-04-13T11:00:00.000Z"
}

### Delete reservation by id
DELETE {{baseUrl}}/reserveringen/{{reservationId}}
Authorization: Bearer {{userToken}}

### Overlap example should fail with 400
POST {{baseUrl}}/reserveringen
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "kamerNaam": "Kamer1",
  "startTijd": "2021-10-20T07:30:00.000Z",
  "eindTijd": "2021-10-20T07:45:00.000Z"
}

### Unauthorized example should fail with 401
GET {{baseUrl}}/reserveringen

### Forbidden example should fail with 403
PUT {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "naam": "Forbidden",
  "achternaam": "User",
  "email": "forbidden@example.com",
  "active": true,
  "notLocked": true
}
